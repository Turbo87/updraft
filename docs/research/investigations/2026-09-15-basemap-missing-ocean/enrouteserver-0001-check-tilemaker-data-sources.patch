+def checkTilemakerSources(configFileName):
+    """Checks that every external data source in a tilemaker configuration exists
+
+    Tilemaker skips a layer whose shapefile source cannot be opened. It does
+    not report an error and generates the map without ocean, urban area,
+    glacier, and ice shelf polygons. This method raises an exception before
+    tilemaker runs, so that the missing data is not deployed.
+
+    :param configFileName: Name of the tilemaker configuration file
+
+    :raises FileNotFoundError: A layer source does not exist
+    """
+
+    with open(configFileName) as configFile:
+        config = json.load(configFile)
+    missing = []
+    for layerName, layer in config['layers'].items():
+        source = layer.get('source')
+        if source is None:
+            continue
+        if source.endswith('.shp'):
+            # Shapelib needs the geometry and the attribute file
+            required = [source, source[:-4]+'.dbf']
+        else:
+            required = [source]
+        for fileName in required:
+            if not os.path.isfile(fileName):
+                missing.append('{} (layer {})'.format(fileName, layerName))
+    if missing:
+        raise FileNotFoundError(
+            'Tilemaker data sources are missing. Run downloadData.sh first.\n  '
+            + '\n  '.join(missing))
+
+
 def pbf2mbtiles(pbfFileName, minLon, minLat, maxLon, maxLat, mbtilesFileBaseName, country):
     """Converts openstreetmap PBF file into mbtiles
 
