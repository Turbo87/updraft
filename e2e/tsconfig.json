{
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "$lib": ["../frontend/src/lib"],
      "$lib/*": ["../frontend/src/lib/*"]
    },
    "strict": true,
    "target": "ES2022",
    "types": ["geojson", "node"]
  },
  "include": ["playwright.config.ts", "tests/**/*.ts"]
}
